{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Encore",
  "version": "0.1.0",
  "identifier": "com.gisketch.encore",
  "build": {
    "beforeDevCommand": "npm run prepare:ffmpeg-sidecars && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run prepare:ffmpeg-sidecars && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Encore",
        "width": 760,
        "height": 84,
        "minWidth": 680,
        "minHeight": 84,
        "center": true,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visibleOnAllWorkspaces": true
      },
      {
        "label": "settings",
        "title": "Settings",
        "width": 560,
        "height": 480,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": false,
        "center": true,
        "visible": false
      },
      {
        "label": "library",
        "title": "Library",
        "width": 1060,
        "height": 640,
        "resizable": true,
        "maximizable": false,
        "minimizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": false,
        "center": true,
        "visible": false
      },
      {
        "label": "preview",
        "title": "Preview",
        "width": 320,
        "height": 250,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "visible": false,
        "visibleOnAllWorkspaces": true
      },
      {
        "label": "editor",
        "title": "Editor",
        "width": 1060,
        "height": 640,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "maximizable": false,
        "minimizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": false,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "binaries/ffmpeg",
      "binaries/ffprobe"
    ],
    "resources": [
      "resources/save-chime.wav"
    ],
    "macOS": {
      "minimumSystemVersion": "14.0"
    }
  }
}
